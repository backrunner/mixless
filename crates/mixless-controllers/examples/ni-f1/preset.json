  "id": "builtin-ni-f1-fl-studio-v1",
  "name": "Traktor Kontrol F1 (FL Studio template)",
  "manufacturer": "Native Instruments",
  "notes": "Requires Controller Editor 2.8.2's unmodified FL Studio template, Basic page, and MIDI mode (Shift + Browse). This is an independent mixless transport/stem layout, not a factory MIDI mapping. Pads 1–8 control deck A and 9–16 deck B: Play, Sync, PFL, Loop, Key Lock, Vinyl, Slip, Reverse. Knobs control A stems; faders control B stems. Shift page, display and pad colors are unmapped. Pad brightness feedback only. Hardware unverified.",
  "provenance": [
    {
      "url": "https://support.native-instruments.com/support/solutions/articles/69000882238-native-instruments-drivers-other-files",
      "revision": "Controller Editor 2.8.2",
      "section": "Templates/FL Studio.nckf1; Basic page; see NI_COMPATIBILITY.md for source fingerprints"
    }
