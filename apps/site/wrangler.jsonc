{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixless-site",
  "account_id": "b6754402d59fc29ee8b62119014fec89",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mixless.alkinum.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "build",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
